{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=<DatabaseServerEndpoint>,<DatabasePort>;Database=<DatabaseName>;User Id=<UserId>;Password=<UserPassword>;Encrypt=True;TrustServerCertificate=True;"
    }
}
